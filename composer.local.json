{
    "name": "phasync/phasync.github.io",
    "description": "composer.json with the sibling checkouts as sources: the reference describes the code as it is now, not as last released. Use: COMPOSER=composer.local.json composer install",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {"type": "path", "url": "../phasync", "options": {"symlink": true, "versions": {"phasync/phasync": "2.0.0-beta4"}}},
        {"type": "path", "url": "../swerve", "options": {"symlink": true, "versions": {"phasync/swerve": "0.1.0-beta1"}}},
        {"type": "path", "url": "../http-client", "options": {"symlink": true, "versions": {"phasync/http-client": "2.0.0-alpha1"}}}
    ],
    "require": {
        "php": "^8.2",
        "league/commonmark": "^2.5",
        "symfony/yaml": "^6.4 || ^7.0",
        "phpdocumentor/reflection-docblock": "^5.6"
    },
    "require-dev": {
        "phasync/phasync": "^2.0.0-beta4",
        "phasync/swerve": "^0.1.0-beta1",
        "phasync/http-client": "^2.0.0-alpha1"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
